<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Help">

    <ScrollView
    android:layout_width="match_parent"
    android:layout_marginTop="20dp"
    android:layout_height="match_parent">

    <LinearLayout

        android:layout_width="match_parent"

        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:padding="20dp">

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Help &amp; Support"

            android:textSize="24sp"

            android:textStyle="bold"

            android:textColor="@android:color/black"/>

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="50dp"

            android:text="Frequently Asked Questions"

            android:textStyle="bold"

            android:textSize="18sp"/>

        <TextView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="• How do I add a product?\nOpen the Add page from the bottom navigation and enter the product details."/>

        <TextView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="• How do I update stock?\nOpen Products, select a product, and edit its quantity."/>

        <TextView

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="12dp"

            android:text="• How do I record a sale?\nTap Sales from the bottom navigation and create a new sales record."/>

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:layout_marginTop="24dp"

            android:text="Contact Support"

            android:textStyle="bold"

            android:textSize="18sp"/>

        <TextView

            android:layout_width="wrap_content"
            android:id="@+id/txtEmail"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Email: support@iamafei68@gmail.com"/>

        <TextView

            android:layout_width="wrap_content"

            android:layout_height="wrap_content"

            android:text="Phone: +233 271544334/ +233 54243872"/>

        <Button

            android:id="@+id/btnContact"

            android:layout_width="match_parent"

            android:layout_height="wrap_content"

            android:layout_marginTop="48dp"

            android:text="Contact Support"/>

    </LinearLayout>

</ScrollView>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:menu="@menu/bottom"
        app:labelVisibilityMode="labeled"
        android:layout_alignParentBottom="true" />

</androidx.constraintlayout.widget.ConstraintLayout>